# Supabase Dashboard → Connect → Transaction pooler жолын толық көшір.
# Ортақ pooler қолданушысы postgres.<project-ref>, порты 6543 болады.
# Құпиясөздегі арнайы таңбаларды URI үшін percent-encode ету керек.
# Бұл файлды көшіріп, .env деп ата да, өз мәніңді қой. .env git-ке кірмейді.
DATABASE_URL=

# «Бүгін» мен «осы апта» қай уақыт белдеуімен есептеледі
APP_TZ=Asia/Almaty

# API порты (міндетті емес)
PORT=3080

# Postgres пулының көлемі. Әдепкі 1 — Vercel-де әр функция данасы өз пулын
# ашады. Тұрақты серверде қажет болса 10-ға көтеруге болады.
PG_POOL_MAX=

# Ескі сессиялар мен токендерді тазалайтын cron маршрутын қорғайды
# (`/api/cron/purge`). Vercel-де қажет; тұрақты серверде тазалауды процестің
# өзі істейді, сондықтан керегі жоқ. Кез келген ұзын кездейсоқ жол болады:
# `openssl rand -hex 32`
CRON_SECRET=

# Хат жіберу (құпиясөзді қалпына келтіру мен email растау). Екеуі де
# қойылмаса, сілтеме тек сервердің консоліне жазылады — жергілікті әзірлеуге
# жеткілікті, ал продакшнда маршрут ашық түрде 503 қайтарады.
# Кілт: resend.com → API Keys. MAIL_FROM домені сол жерде расталған болуы керек.
RESEND_API_KEY=
MAIL_FROM=Focus10 <hello@example.com>

# Хаттағы сілтеме қай мекенжайға сілтейді. Vercel мен Render-де қоюдың
# қажеті жоқ: екеуі де өз доменін айнымалымен береді. Өз домені болғанда
# ғана керек.
APP_URL=http://localhost:5180
